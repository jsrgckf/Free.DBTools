<Window x:Class="Free.DBTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free.DBTools · 多数据库连接工具"
        Width="1320" Height="840"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ThemeSegment" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部标题栏 ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="DB"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Free.DBTools" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="多数据库连接工具 · SqlSugar / .NET Framework 4.8"
                                   Style="{DynamicResource HintText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{DynamicResource Pill}" Margin="0,0,8,0">
                        <TextBlock Text="SQL Server · MySQL · PostgreSQL · Oracle · SQLite · 达梦 · 人大金仓 · OpenGauss · Access"
                                   Style="{DynamicResource HintText}" />
                    </Border>
                    <Border Style="{DynamicResource Pill}">
                        <TextBlock Text="v1.0" Style="{DynamicResource HintText}" />
                    </Border>
                    <Border Style="{DynamicResource Pill}" Margin="8,0,0,0" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="BtnThemeLight"
                                          Content="浅色"
                                          Style="{DynamicResource ThemeSegment}"
                                          ToolTip="浅色主题"
                                          Checked="BtnTheme_Changed"
                                          Unchecked="BtnTheme_Changed" />
                            <ToggleButton x:Name="BtnThemeDark"
                                          Content="深色"
                                          Style="{DynamicResource ThemeSegment}"
                                          ToolTip="深色主题"
                                          Margin="2,0,0,0"
                                          Checked="BtnTheme_Changed"
                                          Unchecked="BtnTheme_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="356" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：连接配置 + 对象树 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="连接配置"
                                       Style="{DynamicResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnDeleteProfile"
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource GhostButton}"
                                    Content="删除"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Click="BtnDeleteProfile_Click" />
                            <ComboBox x:Name="CmbProfiles"
                                      DockPanel.Dock="Right"
                                      Width="168"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="CmbProfiles_SelectionChanged"
                                      ToolTip="选择已保存的配置以载入">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplaySummary}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <TextBlock Text="数据库类型" Style="{DynamicResource FieldLabel}" Margin="1,12,0,5" />
                        <ComboBox x:Name="CmbKind"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="CmbKind_SelectionChanged" />

                        <Grid x:Name="ServerPanel" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主机 / 服务器" Style="{DynamicResource FieldLabel}" />
                            <TextBlock Grid.Column="2" Text="端口" Style="{DynamicResource FieldLabel}" />
                            <TextBox x:Name="TxtHost" Grid.Row="1" />
                            <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="2" />
                        </Grid>

                        <Grid x:Name="OraclePanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="服务名" Style="{DynamicResource FieldLabel}" />
                            <TextBox x:Name="TxtDatabase" Grid.Row="1" ToolTip="Oracle 服务名 / SID，可留空使用主机默认实例" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="用户名" Style="{DynamicResource FieldLabel}" />
                            <TextBlock Grid.Column="2" Text="密码" Style="{DynamicResource FieldLabel}" />
                            <TextBox x:Name="TxtUser" Grid.Row="1" />
                            <Grid Grid.Row="1" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PwdBox" />
                                <TextBox x:Name="TxtPasswordPlain" Visibility="Collapsed" />
                                <CheckBox x:Name="ChkShowPassword"
                                          Grid.Column="1"
                                          Content="显示"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Checked="ChkShowPassword_Changed"
                                          Unchecked="ChkShowPassword_Changed" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="FilePanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据库文件" Style="{DynamicResource FieldLabel}" />
                            <TextBox x:Name="TxtFile" Grid.Row="1" />
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Content="浏览…"
                                    Click="BtnBrowse_Click" />
                        </Grid>

                        <CheckBox x:Name="ChkUseCustom"
                                  Content="使用自定义连接字符串"
                                  Margin="0,12,0,0"
                                  Checked="ChkUseCustom_Changed"
                                  Unchecked="ChkUseCustom_Changed" />
                        <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBox x:Name="TxtCustomConn"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="58"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" />
                            <TextBlock Text="勾选后忽略上方的服务器与账号字段，直接使用该连接字符串。"
                                       Style="{DynamicResource HintText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Padding="9,7"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="TxtDriverNote" Style="{DynamicResource HintText}" />
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnConnect"
                                    Content="连接数据库"
                                    Style="{DynamicResource PrimaryButton}"
                                    Click="BtnConnect_Click" />
                            <Button x:Name="BtnTest"
                                    Grid.Column="1"
                                    Content="测试连接"
                                    Margin="8,0,0,0"
                                    Click="BtnTest_Click" />
                            <Button x:Name="BtnSave"
                                    Grid.Column="2"
                                    Content="保存配置"
                                    Style="{DynamicResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Click="BtnSave_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Card}" Grid.Row="1" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="数据库对象"
                                       Style="{DynamicResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    x:Name="BtnRefreshObjects"
                                    Content="刷新"
                                    Style="{DynamicResource GhostButton}"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Click="BtnRefreshObjects_Click" />
                        </DockPanel>
                        <Grid x:Name="DatabasePanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据库"
                                       Style="{DynamicResource FieldLabel}"
                                       Margin="1,0,8,0"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CmbDatabase"
                                      Grid.Column="1"
                                      SelectionChanged="CmbDatabase_SelectionChanged"
                                      ToolTip="连接成功后在此选择数据库，切换后将重新加载表与视图" />
                        </Grid>
                        <TextBox x:Name="TxtObjectFilter"
                                 Grid.Row="2"
                                 Margin="0,8,0,8"
                                 ToolTip="按名称过滤表 / 视图"
                                 TextChanged="TxtObjectFilter_TextChanged" />
                        <Grid Grid.Row="3">
                            <TreeView x:Name="TreeObjects" SelectedItemChanged="TreeObjects_SelectedItemChanged" />
                            <TextBlock x:Name="TxtTreeEmpty"
                                       Text="连接数据库后，将在此列出表与视图。"
                                       Style="{DynamicResource HintText}"
                                       Margin="6,4,0,0"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="2"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE" />

            <!-- ===== 右侧：数据浏览 / SQL 查询 ===== -->
            <TabControl x:Name="MainTabs" Grid.Column="2">
                <TabItem Header="数据浏览">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="12,8,12,6" LastChildFill="False">
                            <TextBlock Text="当前表："
                                       Style="{DynamicResource HintText}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtCurrentObject"
                                       Text="未选择"
                                       Margin="2,0,0,0"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="BtnExportCsv"
                                    DockPanel.Dock="Right"
                                    Content="导出 CSV"
                                    Style="{DynamicResource GhostButton}"
                                    Click="BtnExportCsv_Click" />
                            <Button x:Name="BtnRefreshData"
                                    DockPanel.Dock="Right"
                                    Content="刷新"
                                    Margin="0,0,6,0"
                                    Style="{DynamicResource GhostButton}"
                                    Click="BtnRefreshData_Click" />
                            <TextBlock x:Name="TxtRowCount"
                                       DockPanel.Dock="Right"
                                       Text="0 行"
                                       Style="{DynamicResource HintText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                        </DockPanel>

                        <DataGrid x:Name="GridData" Grid.Row="1" Margin="12,0,12,0">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="复制所选单元格" Click="MenuCopyCells_Click" />
                                    <MenuItem Header="导出为 CSV…" Click="BtnExportCsv_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Margin="12,8,12,12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="7"
                                Padding="10,5">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="每页"
                                           Style="{DynamicResource HintText}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbPageSize"
                                          Width="80"
                                          Height="26"
                                          Margin="6,0,0,0"
                                          SelectionChanged="CmbPageSize_SelectionChanged" />
                                <TextBlock Text="条"
                                           Style="{DynamicResource HintText}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,14,0" />
                                <Button x:Name="BtnFirst"
                                        Content="首页"
                                        Padding="10,3"
                                        Click="BtnFirst_Click" />
                                <Button x:Name="BtnPrev"
                                        Content="上一页"
                                        Margin="6,0,0,0"
                                        Padding="10,3"
                                        Click="BtnPrev_Click" />
                                <TextBlock x:Name="TxtPageInfo"
                                           Text="第 1 页"
                                           VerticalAlignment="Center"
                                           Margin="12,0,12,0"
                                           FontSize="12" />
                                <Button x:Name="BtnNext"
                                        Content="下一页"
                                        Padding="10,3"
                                        Click="BtnNext_Click" />
                                <Button x:Name="BtnLast"
                                        Content="末页"
                                        Margin="6,0,0,0"
                                        Padding="10,3"
                                        Click="BtnLast_Click" />
                                <TextBlock x:Name="TxtPagerHint"
                                           DockPanel.Dock="Right"
                                           Style="{DynamicResource HintText}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="SQL 查询">
                    <Grid x:Name="SqlTab">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="170" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="12,8,12,6" LastChildFill="False">
                            <Button x:Name="BtnExecute"
                                    Content="执行 (F5)"
                                    Style="{DynamicResource PrimaryButton}"
                                    Click="BtnExecute_Click" />
                            <Button Content="清空"
                                    Margin="8,0,0,0"
                                    Style="{DynamicResource GhostButton}"
                                    Click="BtnClearSql_Click" />
                            <TextBlock Text="选中部分文本时只执行选中语句 · Ctrl+Enter 也可执行"
                                       DockPanel.Dock="Right"
                                       Style="{DynamicResource HintText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBox x:Name="TxtSql"
                                 Grid.Row="1"
                                 Margin="12,0,12,0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="TxtSql_TextChanged"
                                 SelectionChanged="TxtSql_SelectionChanged"
                                 PreviewKeyDown="TxtSql_PreviewKeyDown" />

                        <GridSplitter Grid.Row="2"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="{DynamicResource BorderBrush}" />

                        <Grid Grid.Row="3" Margin="12,0,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtSqlMessage"
                                       Text="就绪。"
                                       Style="{DynamicResource HintText}"
                                       Margin="0,0,0,6" />
                            <TabControl x:Name="SqlResultTabs" Grid.Row="1" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ===== 忙碌遮罩 ===== -->
            <Border x:Name="BusyLayer"
                    Grid.ColumnSpan="3"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"
                    Background="{DynamicResource BusyOverlayBrush}"
                    CornerRadius="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="220"
                                 Height="4"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource SurfaceAltBrush}" />
                    <TextBlock x:Name="TxtBusy"
                               Text="处理中…"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== SQL 自动补全 ==================== -->
        <Popup x:Name="AutoCompletePopup"
               AllowsTransparency="True"
               StaysOpen="False"
               Focusable="False"
               PopupAnimation="Fade"
               Placement="Relative"
               PlacementTarget="{Binding ElementName=TxtSql}">
            <Border Width="340"
                    MaxHeight="268"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#FF64748B" />
                </Border.Effect>
                <ListBox x:Name="AutoCompleteList"
                         MaxHeight="256"
                         Focusable="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonDown="AutoCompleteList_PreviewMouseLeftButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Category}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="Consolas"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <DockPanel>
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         Fill="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="TxtConnStatus"
                           Text="未连接"
                           Margin="8,0,16,0"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TxtServerVersion"
                           DockPanel.Dock="Right"
                           Style="{DynamicResource HintText}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0" />
                <TextBlock x:Name="TxtLog"
                           Style="{DynamicResource HintText}"
                           Text="就绪"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
